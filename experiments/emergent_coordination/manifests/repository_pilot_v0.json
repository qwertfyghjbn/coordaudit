{
  "repository_id": "repo_pilot_v0",
  "version": "v0",
  "display_name": "Northstar Workspace",
  "target_root": "experiments/emergent_coordination/repositories/repository_pilot_v0",
  "ground_truth": "experiments/emergent_coordination/evaluator_private/repository_pilot_v0/ground_truth.json",
  "provenance": "experiments/emergent_coordination/evaluator_private/repository_pilot_v0/provenance.json",
  "purpose": "harness validation for repository-level multi-agent coordination",
  "hidden_targets": {
    "positive": ["GT-001", "GT-002", "GT-003"],
    "near_miss": ["NM-001", "NM-002"]
  },
  "supported_modes": ["single", "parallel", "raw_blackboard", "structured_team"],
  "supported_agent_counts": [1, 2, 4, 8, 16, 32],
  "default_budgets": {
    "global_input_token_cap": 200000,
    "global_output_token_cap": 80000,
    "per_agent_token_cap": 100000,
    "max_llm_calls": 40,
    "wall_clock_timeout": 600
  },
  "smoke_budgets": {
    "global_input_token_cap": 4000,
    "global_output_token_cap": 2000,
    "per_agent_token_cap": 2000,
    "max_llm_calls": 4,
    "wall_clock_timeout": 60
  },
  "permissions": {
    "local_shell": true,
    "target_source": true,
    "local_tests": true,
    "internet": false,
    "external_network": false,
    "web_search": false,
    "host_filesystem": false,
    "evaluator_private": false
  },
  "notes": [
    "Agent-visible target must not contain ground truth, source case IDs, or provenance.",
    "Pilot is not a formal repository-v1 benchmark."
  ]
}
