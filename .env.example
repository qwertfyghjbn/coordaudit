# Copy to a private .env file or export in your shell. Never commit a real key.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/
LLM_MODEL=deepseek-flash
# The N=4 v0 profile explicitly uses non-thinking mode: DeepSeek otherwise
# ignores temperature, while the frozen contract requires temperature=0.
LLM_THINKING_MODE=disabled
